$C = "../../../Common.ui";

@SecondaryButton = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 14, TextColor: #CCCCCC, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 15, TextColor: $C.@ColorGoldHighlight, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (LabelStyle: (FontSize: 14, TextColor: #CCCCCC, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group #JutsuCardRoot {
    LayoutMode: Left;
    Anchor: (Width: 400, Height: 96, Top: 6);
    Background: (TexturePath: "../../../Common/ContainerPanelPatch.png", Border: 4);
    Padding: (Full: 6);

    // --- INFORMAÇÕES E DETALHES ---
    Group #JutsuInfo {
        LayoutMode: Top;
        Anchor: (Left: 10, Width: 270, Height: 84);

        // Cabeçalho: Nome e Tipo
        Group #RowHeader {
            LayoutMode: Left;
            Anchor: (Height: 20);

            Label #LabelJutsuName {
                Anchor: (Height: 20);
                Text: "Jutsu Name";
                Style: (...$C.@DefaultLabelStyle, TextColor: #ffffff, RenderBold: true, FontSize: 13, VerticalAlignment: Center);
            }

            Label #LabelJutsuType {
                Anchor: (Left: 8, Height: 20);
                Text: "[Ninjutsu]";
                Style: (...$C.@DefaultLabelStyle, FontSize: 10, TextColor: #E8A93B, VerticalAlignment: Center);
            }
        }

        // Linha Secundária: Badges / Chips de Atributos e Progresso
        Group #ColumnItems {
            LayoutMode: Top;
            Anchor: (Top: 6);

            // Linha 1: Custo de Chakra & Nível Atual
            Group #RowItems1 {
                LayoutMode: Left;
                Anchor: (Height: 18);

                Group #ChipCost {
                    LayoutMode: Left;
                    Background: #000000(0.35);
                    Padding: (Left: 6, Right: 6, Top: 2, Bottom: 2);

                    Label #LabelJutsuCost {
                        Text: "Chakra: 30";
                        Style: (...$C.@DefaultLabelStyle, FontSize: 10, TextColor: #4a90e2, RenderBold: true, VerticalAlignment: Center);
                    }
                }

                Group #ChipLevel {
                    LayoutMode: Left;
                    Anchor: (Left: 6);
                    Background: #000000(0.35);
                    Padding: (Left: 6, Right: 6, Top: 2, Bottom: 2);

                    Label #LabelJutsuLevel {
                        Text: "Lv. 1";
                        Style: (...$C.@DefaultLabelStyle, FontSize: 10, TextColor: #50E3C2, RenderBold: true, VerticalAlignment: Center);
                    }
                }
            }

            // Linha 2: XP Atual e Requisitos
            Group #RowItems2 {
                LayoutMode: Left;
                Anchor: (Top: 4, Height: 18);

                Group #ChipXp {
                    LayoutMode: Left;
                    Background: #000000(0.35);
                    Padding: (Left: 6, Right: 6, Top: 2, Bottom: 2);

                    Label #LabelJutsuXp {
                        Text: "XP: 0/50";
                        Style: (...$C.@DefaultLabelStyle, FontSize: 10, TextColor: #F5A623, VerticalAlignment: Center);
                    }
                }

                Group #ChipReq {
                    LayoutMode: Left;
                    Anchor: (Left: 6);
                    Background: #000000(0.35);
                    Padding: (Left: 6, Right: 6, Top: 2, Bottom: 2);

                    Label #LabelJutsuReq {
                        Text: "Req: Lvl 1";
                        Style: (...$C.@DefaultLabelStyle, FontSize: 10, TextColor: #d0d2d6, VerticalAlignment: Center);
                    }
                }
            }
        }
    }

    // --- BOTÃO DE AÇÃO ---
    Group #JutsuAction {
        LayoutMode: Left;
        Anchor: (Width: 90, Height: 84);

        TextButton #BtnJutsuAction{
            Text: "";
            Anchor: (Width: 90, Height: 30, Top: 27);
            Background: (PatchStyle(TexturePath: "../../Assets/BgButton2.png"));
            Style: @SecondaryButton;
        }

//        $C.@SmallSecondaryTextButton #BtnJutsuAction {
//            @Text = "APRENDER";
//
//        }
    }
}