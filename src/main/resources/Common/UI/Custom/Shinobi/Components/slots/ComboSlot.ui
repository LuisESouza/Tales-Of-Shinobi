$C = "../../../Common.ui";

Group #ComboSlotRoot {
  LayoutMode: Top;

  Group #Slot1 {
    LayoutMode: Top;
    Anchor: (Height: 68, Width: 280);
    Background: (TexturePath: "../../../Common/ContainerPanelPatch.png", Border: 4);
    Padding: (Full: 6);

     Group #ComboBadge1 {
        LayoutMode: Left;
        Anchor: (Width: 268, Height: 22);
        Background: (TexturePath: "../../../Common/ContainerPanelPatch.png", Border: 4, Color: #15171e);

        Label #LabelCombo1 {
            Anchor: (Width: 268, Height: 22);
            Text: "Left - Left - Left";
            Style: (...$C.@DefaultLabelStyle, TextColor: #e6ad45, RenderBold: true, FontSize: 12, VerticalAlignment: Center, HorizontalAlignment: Center);
        }
     }

    Label #LabelSlot1 {
        Anchor: (Top: 4, Width: 268, Height: 28);
        Text: "Empty Slot";
        Style: (...$C.@DefaultLabelStyle, TextColor: #d1d5db, RenderBold: true, FontSize: 14, VerticalAlignment: Center, HorizontalAlignment: Center);
    }
  }
  //---------------------------------------------------//
  Group #Slot2 {
    LayoutMode: Top;
    Anchor: (Top: 8, Height: 68, Width: 280);
    Background: (TexturePath: "../../../Common/ContainerPanelPatch.png", Border: 4);
    Padding: (Full: 6);

    Group #ComboBadge2 {
        LayoutMode: Left;
        Anchor: (Width: 268, Height: 22);
        Background: (TexturePath: "../../../Common/ContainerPanelPatch.png", Border: 4, Color: #15171e);

        Label #LabelCombo2 {
            Anchor: (Width: 268, Height: 22);
            Text: "Left - Left - F";
            Style: (...$C.@DefaultLabelStyle, TextColor: #e6ad45, RenderBold: true, FontSize: 12, VerticalAlignment: Center, HorizontalAlignment: Center);
        }
    }

    Label #LabelSlot2 {
        Anchor: (Top: 4, Width: 268, Height: 28);
        Text: "Empty Slot";
        Style: (...$C.@DefaultLabelStyle, TextColor: #d1d5db, RenderBold: true, FontSize: 14, VerticalAlignment: Center, HorizontalAlignment: Center);
    }
  }
  //---------------------------------------------------//
  Group #Slot3 {
    LayoutMode: Top;
    Anchor: (Top: 8, Height: 68, Width: 280);
    Background: (TexturePath: "../../../Common/ContainerPanelPatch.png", Border: 4);
    Padding: (Full: 6);

    Group #ComboBadge3 {
        LayoutMode: Left;
        Anchor: (Width: 268, Height: 22);
        Background: (TexturePath: "../../../Common/ContainerPanelPatch.png", Border: 4, Color: #15171e);

        Label #LabelCombo3 {
            Anchor: (Width: 268, Height: 22);
            Text: "Left - F - Left";
            Style: (...$C.@DefaultLabelStyle, TextColor: #e6ad45, RenderBold: true, FontSize: 12, VerticalAlignment: Center, HorizontalAlignment: Center);
        }
    }

    Label #LabelSlot3 {
        Anchor: (Top: 4, Width: 268, Height: 28);
        Text: "Empty Slot";
        Style: (...$C.@DefaultLabelStyle, TextColor: #d1d5db, RenderBold: true, FontSize: 14, VerticalAlignment: Center, HorizontalAlignment: Center);
    }
  }
  //------------------------------------------------------//
  Group #Slot4 {
    LayoutMode: Top;
    Anchor: (Top: 8, Height: 68, Width: 280);
    Background: (TexturePath: "../../../Common/ContainerPanelPatch.png", Border: 4);
    Padding: (Full: 6);

    Group #ComboBadge4 {
        LayoutMode: Left;
        Anchor: (Width: 268, Height: 22);
        Background: (TexturePath: "../../../Common/ContainerPanelPatch.png", Border: 4, Color: #15171e);

        Label #LabelCombo4 {
            Anchor: (Width: 268, Height: 22);
            Text: "Left - F - F";
            Style: (...$C.@DefaultLabelStyle, TextColor: #e6ad45, RenderBold: true, FontSize: 12, VerticalAlignment: Center, HorizontalAlignment: Center);
        }
    }

    Label #LabelSlot4 {
        Anchor: (Top: 4, Width: 268, Height: 28);
        Text: "Empty Slot";
        Style: (...$C.@DefaultLabelStyle, TextColor: #d1d5db, RenderBold: true, FontSize: 14, VerticalAlignment: Center, HorizontalAlignment: Center);
    }
  }
}
