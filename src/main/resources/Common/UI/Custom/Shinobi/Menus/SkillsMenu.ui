$C = "../../Common.ui";

@SecondaryButton = TextButtonStyle(
  Default: (LabelStyle: (FontSize: 14, TextColor: #CCCCCC, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Hovered: (LabelStyle: (FontSize: 15, TextColor: $C.@ColorGoldHighlight, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center)),
  Pressed: (LabelStyle: (FontSize: 14, TextColor: #CCCCCC, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center))
);

Group #SkillsMenuRoot {
    Anchor: (Width: 1040, Height: 800, Top: 180);
    LayoutMode: Top;

    Group #NavigationContent {
        Anchor: (Width: 1040, Height: 50);
        LayoutMode: Center;
    }

    Group #MainContent {
        Anchor: (Width: 1040, Height: 590, Top: 2);
        LayoutMode: Left;

        Group #MaintContent {
            Anchor: (Right: 5, Width: 940, Height: 590);
            Background: PatchStyle(TexturePath: "../Assets/BgSkills.png");
            LayoutMode: Left;

            // ================= PAINEL ESQUERDO (EQUIPPED SKILLS) =================
            Group #EquippedContainer {
                Anchor: (Width: 340, Height: 520, Top: 70);
                LayoutMode: Top;

                Group #Title {
                    Anchor: (Width: 300, Height: 40, Left: 75);
                    LayoutMode: Center;

                    Label {
                        Text: "EQUIPPED SKILLS";
                        Style: (...$C.@DefaultLabelStyle, TextColor: #2A1A0A, RenderBold: true, FontSize: 20, VerticalAlignment: Center);
                    }
                }

                Group #Content {
                    LayoutMode: Top;
                    Anchor: (Width: 300, Height: 440);
                    Padding: (Horizontal: 10, Vertical: 10);

                    Group #EquippedJutsusPanel {
                        LayoutMode: Top;
                        Anchor: (Top: 26, Width: 280, Height: 410, Left: 50);
                        //Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);
                        Padding: (Full: 10);
                    }
                }
            }

            // ================= PAINEL DIREITO (SKILL TREE) =================
            Group #SkillsContainer {
                Anchor: (Width: 440, Height: 520, Top: 143, Left: 55);
                LayoutMode: Top;

                Group #Title {
                    Anchor: (Width: 400, Height: 24);
                    LayoutMode: Center;

                    Label {
                        Text: "SKILL TREE";
                        Style: (...$C.@DefaultLabelStyle, TextColor: $C.@ColorGoldHighlight, RenderBold: true, FontSize: 16, VerticalAlignment: Center);
                    }
                }

                Group #Content {
                    LayoutMode: Top;
                    Anchor: (Width: 420, Height: 440, Top: 10);
                    Padding: (Horizontal: 10, Vertical: 10);

                    Group #SkillsContent {
                        LayoutMode: Top;
                        Anchor: (Top: 0, Width: 400, Height: 230);
                        Padding: (Full: 5);
                    }

                    Group #Pagination {
                        LayoutMode: Center;
                        Anchor: (Top: 10, Width: 400, Height: 35);

                        TextButton #BtnPrev{
                            Text: "Prev";
                            Anchor: (Width: 110, Height: 35);
                            Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                            Style: @SecondaryButton;
                        }

                        Label #LabelPagination {
                            Anchor: (Width: 120);
                            Text: "1 / 1";
                            Style: (...$C.@DefaultLabelStyle, TextColor: #2A1A0A, RenderBold: true, VerticalAlignment: Center, HorizontalAlignment: Center);
                        }

                        TextButton #BtnNext{
                            Text: "Next";
                            Anchor: (Width: 110, Height: 35);
                            Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                            Style: @SecondaryButton;
                        }

    //                    $C.@SecondaryTextButton #BtnNext {
    //                        @Text = "Next";
    //                        Anchor: (Width: 110, Height: 35);
    //                    }
                    }
                }
            }
        }

        // --- NAVEGAÇÃO SUPERIOR DE CATEGORIAS ---
        Group #NavBar {
            LayoutMode: Top;
            Anchor: (Width: 98, Height: 590, Top: 80, Left: 0);

            //NavBar (Taijutsu, Ninjutsu, Genjutsu adn Clan)
            Group #NavBarJutsu{
                LayoutMode: Top;

                TextButton #BtnTabTaijutsu {
                    Text: "TAIJUTSU";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }

                TextButton #BtnTabNinjutsu {
                    Text: "NINJUTSU";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }

                TextButton #BtnTabGenjutsu {
                    Text: "GENJUTSU";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }

                TextButton #BtnTabClan {
                    Text: "CLAN";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }
            }

            //NavBarElements - (Fire, Water, Wind, Earth and Rain)
            Group #NavBarElements{
                LayoutMode: Top;
                Anchor: (Top: 15);

                TextButton #BtnTabFire{
                    Text: "Fire";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }

                TextButton #BtnTabWater{
                    Text: "Water";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }

                TextButton #BtnTabWind{
                    Text: "Wind";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }

                TextButton #BtnTabEarth{
                    Text: "Earth";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }

                TextButton #BtnTabRain{
                    Text: "Rain";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }

                TextButton #BtnTabOthers{
                    Text: "Others";
                    Anchor: (Width: 98, Height: 32, Top: 8);
                    Background: (PatchStyle(TexturePath: "../Assets/BgButton2.png"));
                    Style: @SecondaryButton;
                }
            }
        }
    }
}

$C.@BackButton {}